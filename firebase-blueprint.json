{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User specific settings and metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "currentLedgerId": { "type": "string", "description": "The ID of the ledger the user is currently looking at" },
        "googleSheetId": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Ledger": {
      "title": "Ledger (Account Book)",
      "description": "A unit of accounting that can be shared or personal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["personal", "shared"] },
        "ownerId": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" }, "description": "List of member UIDs" },
        "memberEmails": { "type": "array", "items": { "type": "string" }, "description": "List of member emails for display/search" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "type", "ownerId", "members"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A single income or expense record matching legacy structure",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "category": { "type": "string" },
        "subCategory": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "memo": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "settlementStatus": { "type": "string" },
        "marker": { "type": "boolean", "description": "🐴🐭" },
        "newSubCategory": { "type": "string" },
        "photoUrl": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "ownerId": { "type": "string" },
        "transferId": { "type": "string" },
        "settledFromAccount": { "type": "string" },
        "settledToAccount": { "type": "string" }
      },
      "required": ["date", "amount", "category", "ownerId"]
    },
    "SubCategory": {
      "title": "Sub Category",
      "description": "Dynamic sub-category list item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "ownerId": { "type": "string" }
      },
      "required": ["name", "ownerId"]
    },
    "AccountCard": {
      "title": "Account or Card",
      "description": "Dynamic payment method list item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "ownerId": { "type": "string" }
      },
      "required": ["name", "ownerId"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Recurring subscription details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cost": { "type": "number" },
        "period": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "notes": { "type": "string" },
        "ownerId": { "type": "string" }
      },
      "required": ["name", "cost", "ownerId"]
    },
    "InvestmentAccount": {
      "title": "Investment Account",
      "description": "Bank account or investment vehicle",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bank": { "type": "string" },
        "name": { "type": "string" },
        "accountNumber": { "type": "string" },
        "balance": { "type": "number" },
        "investmentAmount": { "type": "number" },
        "type": { "type": "string", "enum": ["general", "ISA", "pension", "IRP"] },
        "openDate": { "type": "string", "format": "date" },
        "status": { "type": "string" },
        "ownerId": { "type": "string" }
      },
      "required": ["bank", "name", "ownerId"]
    },
    "Stock": {
      "title": "Stock Investment",
      "description": "Individual stock or asset",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "accountId": { "type": "string" },
        "symbol": { "type": "string" },
        "name": { "type": "string" },
        "quantity": { "type": "number" },
        "avgPrice": { "type": "number" },
        "buyDate": { "type": "string", "format": "date" },
        "ownerId": { "type": "string" }
      },
      "required": ["symbol", "name", "quantity", "avgPrice", "ownerId"]
    },
    "Template": {
      "title": "Transaction Template",
      "description": "Saved transaction for quick entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "type": { "type": "string" },
        "ownerId": { "type": "string" }
      },
      "required": ["name", "ownerId"]
    },
    "ChecklistItem": {
      "title": "Checklist Item",
      "description": "Financial task or reminder",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "completed": { "type": "boolean" },
        "ownerId": { "type": "string" }
      },
      "required": ["title", "ownerId"]
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "Core user profiles"
    },
    "ledgers": {
      "schema": "Ledger",
      "description": "Top-level ledgers (personal or shared)"
    },
    "ledgers/{ledgerId}/transactions": {
      "schema": "Transaction",
      "description": "Transactions belonging to a specific ledger"
    },
    "ledgers/{ledgerId}/subCategories": {
      "schema": "SubCategory",
      "description": "Ledger-specific sub-categories"
    },
    "ledgers/{ledgerId}/accountCards": {
      "schema": "AccountCard",
      "description": "Ledger-specific accounts and cards"
    },
    "ledgers/{ledgerId}/subscriptions": {
      "schema": "Subscription",
      "description": "Ledger-specific subscriptions"
    },
    "ledgers/{ledgerId}/investments": {
      "schema": "InvestmentAccount",
      "description": "Ledger-specific investment accounts"
    },
    "ledgers/{ledgerId}/stocks": {
      "schema": "Stock",
      "description": "Ledger-specific stock holdings"
    },
    "ledgers/{ledgerId}/templates": {
      "schema": "Template",
      "description": "Ledger-specific transaction templates"
    },
    "ledgers/{ledgerId}/checklists": {
      "schema": "ChecklistItem",
      "description": "Ledger-specific checklist items"
    }
  }
}
