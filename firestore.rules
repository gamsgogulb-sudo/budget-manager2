rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isLedgerMember(ledgerId) {
      return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/ledgers/$(ledgerId)).data.members;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. User Profiles
    match /test/connection {
      allow get: if true;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Necessary for inviting members by email
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
    }

    // 2. Ledgers
    match /ledgers/{ledgerId} {
      function isMember() {
        return isSignedIn() && (
          request.auth.uid in resource.data.members ||
          request.auth.token.email in resource.data.memberEmails
        );
      }
      
      allow get: if isMember();
      allow list: if isSignedIn() && (
        resource.data.members.hasAny([request.auth.uid]) ||
        resource.data.memberEmails.hasAny([request.auth.token.email])
      );
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isMember() && (
        // Only members can update (including inviting others)
        request.resource.data.ownerId == resource.data.ownerId
      );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // Sub-collections
      match /{subCollection}/{id} {
        allow read, write: if isLedgerMember(ledgerId);
      }
    }
    
    // Future: Shared groups match block
  }
}
