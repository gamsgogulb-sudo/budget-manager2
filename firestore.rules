rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isLedgerMember(ledgerId) {
      let ledger = get(/databases/$(database)/documents/ledgers/$(ledgerId)).data;
      return isSignedIn() && (
        ledger.members.hasAny([request.auth.uid]) || 
        ledger.memberEmails.hasAny([request.auth.token.email])
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. User Profiles
    match /test/connection {
      allow get: if true;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Necessary for inviting members by email
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
    }

    // 2. Ledgers
    match /ledgers/{ledgerId} {
      function isMember() {
        return isSignedIn() && (
          resource.data.members.hasAny([request.auth.uid]) ||
          resource.data.memberEmails.hasAny([request.auth.token.email])
        );
      }
      
      allow get: if isMember();
      allow list: if isSignedIn() && (
        resource.data.members.hasAny([request.auth.uid]) ||
        resource.data.memberEmails.hasAny([request.auth.token.email])
      );
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isMember() && (
        // Only members can update (including inviting others)
        request.resource.data.ownerId == resource.data.ownerId
      );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // Sub-collections
      match /transactions/{id} { 
        // Optimized create for batches: if ownerId matches and user is member
        allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid && isLedgerMember(ledgerId);
        allow read, update, delete: if isLedgerMember(ledgerId); 
      }
      match /subCategories/{id} { allow read, write: if isLedgerMember(ledgerId); }
      match /accountCards/{id} { allow read, write: if isLedgerMember(ledgerId); }
      match /entrySets/{id} { 
        allow read, write: if isLedgerMember(ledgerId);
      }
      match /checklists/{id} { allow read, write: if isLedgerMember(ledgerId); }
      match /stocks/{id} { allow read, write: if isLedgerMember(ledgerId); }
      match /subscriptions/{id} { allow read, write: if isLedgerMember(ledgerId); }
      match /investments/{id} { allow read, write: if isLedgerMember(ledgerId); }
    }
    
    // Future: Shared groups match block
  }
}
