rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. User Profiles
    match /test/connection {
      allow get: if true;
    }

    match /users/{userId} {
      allow get: if isSignedIn(); // Allow get for search/sharing check
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.keys().hasAll(['uid', 'email']);
      allow update: if isOwner(userId);
      allow delete: if false;

      // Sub-collections
      match /transactions/{id} {
        allow read, write: if isOwner(userId);
      }
      match /subCategories/{id} {
        allow read, write: if isOwner(userId);
      }
      match /accountCards/{id} {
        allow read, write: if isOwner(userId);
      }
      match /subscriptions/{id} {
        allow read, write: if isOwner(userId);
      }
      match /investments/{id} {
        allow read, write: if isOwner(userId);
      }
      match /stocks/{id} {
        allow read, write: if isOwner(userId);
      }
      match /templates/{id} {
        allow read, write: if isOwner(userId);
      }
      match /checklists/{id} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Future: Shared groups match block
  }
}
